@* 
  FLUXO: App.razor é o ponto de entrada do Blazor.
  Router intercepta a URL e encontra o componente correto via [Page "/rota"].
  NotFound é exibido quando nenhuma rota bate.
  
  AuthorizeRouteView garante que páginas com [Authorize] redirecionem
  para /login automaticamente quando o usuário não está autenticado.
  Isso substitui o antigo RouteView + lógica manual.
*@

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        @*
          AuthorizeRouteView combina autorização + roteamento.
          Se a página tiver [Authorize] e o usuário não estiver logado,
          o Blazor exibe o bloco <NotAuthorized> abaixo.
        *@
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                @* Redireciona visitantes não autenticados para o login *@
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>404 — Página não encontrada</PageTitle>
        <LayoutView Layout="@typeof(AuthLayout)">
            <MudPaper Elevation="4" Class="pa-8 text-center"
                      Style="width: 100%; max-width: 400px; border-top: 5px solid #1b5e20; border-radius: 8px;">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large"
                         Style="color: #1b5e20;" Class="mb-4" />
                <MudText Typo="Typo.h5" Class="mb-2" Style="color: #1b5e20; font-weight: bold;">
                    Página não encontrada
                </MudText>
                <MudText Typo="Typo.body1" Class="mb-6 mud-text-secondary">
                    O endereço digitado não existe no sistema.
                </MudText>
                <MudButton Href="/login" Variant="Variant.Filled"
                           Style="background-color: #1b5e20; color: white; font-weight: bold;"
                           FullWidth="true">
                    Ir para o Login
                </MudButton>
            </MudPaper>
        </LayoutView>
    </NotFound>
</Router>